<Window x:Class="CantoWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Canto" Width="420" Height="40" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#072234" Topmost="False" ShowInTaskbar="False" FontFamily="Segoe UI" Foreground="#ECF5FA" UseLayoutRounding="True">
  <Border x:Name="Card" Margin="0" CornerRadius="0" BorderThickness="0" Background="Transparent" TextElement.Foreground="#ECF5FA" TextElement.FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/></Grid.RowDefinitions>
      <Grid Margin="10,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="1"/><ColumnDefinition Width="62"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="4" Background="#14FFFFFF" ClipToBounds="True">
          <Grid><TextBlock Text="♫" FontSize="24" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="Cover" Stretch="UniformToFill"/></Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,5,0">
          <TextBlock x:Name="SongTitle" Text="Nada tocando agora" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="Artist" Text="Abra seu player de música" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Previous" Width="25" Height="30" ToolTip="Música anterior" Click="PreviousClick"><Path Fill="#BCCFDA" Data="M 0,0 L 1.5,0 L 1.5,10 L 0,10 Z M 9,0 L 9,10 L 2,5 Z" Width="10" Height="10" Stretch="Uniform"/></Button>
          <Button x:Name="Play" Width="31" Height="32" ToolTip="Reproduzir / pausar" Click="PlayClick" Background="#16FFFFFF"><Path x:Name="PlayIcon" Fill="#85E4CF" Data="M 0,0 L 0,12 L 9,6 Z" Width="11" Height="12" Stretch="Uniform"/></Button>
          <Button x:Name="Next" Width="25" Height="30" ToolTip="Próxima música" Click="NextClick"><Path Fill="#BCCFDA" Data="M 0,0 L 0,10 L 7,5 Z M 7.5,0 L 9,0 L 9,10 L 7.5,10 Z" Width="10" Height="10" Stretch="Uniform"/></Button>
        </StackPanel>
        <Border Grid.Column="3" Height="29" Background="#26FFFFFF"/>
        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="BatteryArea">
          <Grid Width="28" Height="20">
            <Path Stroke="#D9EDF5" StrokeThickness="1.3" Data="M 10,2 C 4,2 4,6 4,10 L 4,12 C 4,19 16,19 16,12 L 16,10 C 16,6 16,2 10,2 Z M 10,2 L 10,9 M 5,9 L 15,9"/>
            <Ellipse x:Name="BatteryDot" Width="4" Height="4" Fill="#7898A9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2"/>
          </Grid>
          <TextBlock x:Name="BatteryText" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
        </StackPanel>
        <Button Grid.Column="5" Width="25" Height="34" ToolTip="Opções do Canto" Click="OptionsClick"><Path Stroke="#A9C4D2" StrokeThickness="1.5" Data="M 0,0 L 4,4 L 8,0" Width="8" Height="4" Stretch="Uniform"/></Button>
      </Grid>
      <Border Grid.Row="1" Margin="13,0,13,0" Background="#20FFFFFF" CornerRadius="1" ClipToBounds="True"><Grid><Border x:Name="ProgressLine" Background="#538E91" HorizontalAlignment="Left" Width="0"/></Grid></Border>
      <Popup x:Name="Options" Placement="Top" PlacementTarget="{Binding ElementName=Card}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
        <Border Width="330" Background="#0B2638" BorderBrush="#315367" BorderThickness="1" CornerRadius="14" Padding="20">
          <StackPanel>
            <Grid><TextBlock Text="C A N T O" FontSize="11" FontWeight="Bold" Foreground="#85E4CF"/><TextBlock Text="SEU SOM. SEU MOUSE." FontSize="9" Foreground="#7898A9" HorizontalAlignment="Right" Margin="0,2,0,0"/></Grid>
            <TextBlock Text="Tudo no seu canto." FontSize="21" FontWeight="SemiBold" Margin="0,14,0,14"/>
            <Border Background="#123548" CornerRadius="9" Padding="13"><StackPanel><Grid><TextBlock Text="AJAZZ AJ139 Pro" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="DetailPercent" Text="—" HorizontalAlignment="Right" Foreground="#85E4CF"/></Grid><TextBlock x:Name="BatteryDetail" Text="Consultando receptor…" TextWrapping="Wrap" FontSize="11" Foreground="#A5BDC9" Margin="0,7,0,0"/></StackPanel></Border>
            <TextBlock x:Name="GithubStatus" Text="GitHub · verificando conexão" FontSize="10.5" Foreground="#A5BDC9" TextWrapping="Wrap" Margin="0,15,0,10"/>
            <Button Padding="10,9" Click="RefreshBatteryClick" Content="Atualizar bateria agora"/>
            <Button HorizontalContentAlignment="Left" Padding="10,9" Click="ResetPositionClick" Content="Reencaixar na barra de tarefas"/>
            <Button x:Name="StartupButton" Padding="10,9" Click="StartupClick" Content="Iniciar com o Windows"/>
            <Button x:Name="SyncButton" Padding="10,9" Click="SyncClick" Content="Sincronização automática: ligada"/>
            <Button Padding="10,9" Click="ConnectGithubClick" Content="Conectar e publicar no GitHub"/>
            <Button Padding="10,9" Click="RepositoryClick" Content="Abrir projeto no GitHub ↗"/>
            <Border Background="#264555" Height="1" Margin="0,9"/>
            <Grid><TextBlock x:Name="TaskbarStatus" Text="Integrado à barra de tarefas" FontSize="10" Foreground="#7898A9" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Padding="10,7" Click="ExitClick" Content="Sair" Foreground="#B5C9D4"/></Grid>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
